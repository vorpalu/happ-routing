{
  "name": "Happ Clients",
  "description": "Return Xray JSON and compact routing geodata to Happ",
  "enabled": true,
  "operator": "AND",
  "conditions": [
    {
      "headerName": "user-agent",
      "operator": "REGEX",
      "value": "^Happ(?:/|$)",
      "caseSensitive": false
    }
  ],
  "responseType": "XRAY_JSON",
  "responseModifications": {
    "headers": [
      {
        "key": "routing",
        "value": "happ:"
      }
    ],
    "applyHeadersToEnd": true
  }
}
